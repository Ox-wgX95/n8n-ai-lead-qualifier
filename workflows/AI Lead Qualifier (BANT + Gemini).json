      "id": "0a7fdd96-42fd-4707-9381-ba534448259f",
      "name": "Google Gemini Chat Model1",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        -672,
        768
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "rnPUToKDr5WtCfeu",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"score\", \"category\", \"bant\", \"reasoning\", \"recommended_action\", \"red_flags\"],\n  \"properties\": {\n    \"score\": { \"type\": \"number\", \"description\": \"Integer 1-10\" },\n    \"category\": { \"type\": \"string\", \"description\": \"HOT, WARM, COLD, or SPAM\" },\n    \"bant\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"budget\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"score\": { \"type\": \"number\" },\n            \"comment\": { \"type\": \"string\" }\n          }\n        },\n        \"authority\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"score\": { \"type\": \"number\" },\n            \"comment\": { \"type\": \"string\" }\n          }\n        },\n        \"need\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"score\": { \"type\": \"number\" },\n            \"comment\": { \"type\": \"string\" }\n          }\n        },\n        \"timeline\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"score\": { \"type\": \"number\" },\n            \"comment\": { \"type\": \"string\" }\n          }\n        }\n      }\n    },\n    \"reasoning\": { \"type\": \"string\" },\n    \"recommended_action\": { \"type\": \"string\" },\n    \"red_flags\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" }\n    }\n  }\n}"
      },
      "id": "09e521f7-06b5-4ce1-a991-c067e63deb0c",
      "name": "Structured Output Parser1",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        -464,
        768
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst lead = $('Prepare Lead Data1').first().json;\n\nlet q = raw.output !== undefined ? raw.output : raw;\nif (q && typeof q === 'object' && q.output && typeof q.output === 'object' && q.score === undefined) {\n  q = q.output;\n}\nif (typeof q === 'string') {\n  try {\n    q = JSON.parse(q.replace(/```json\\s?/gi, '').replace(/```/g, '').trim());\n  } catch (error) {\n    q = {};\n  }\n}\n\nconst allowed = ['HOT', 'WARM', 'COLD', 'SPAM'];\nconst category = String(q.category || 'COLD').toUpperCase().trim();\nlet score = Number(q.score);\nif (!Number.isFinite(score)) score = 1;\nscore = Math.min(10, Math.max(1, Math.round(score)));\n\nreturn [{\n  json: {\n    name: lead.name,\n    email: lead.email,\n    company: lead.company,\n    budget: lead.budget,\n    project_description: lead.project_description,\n    timeline: lead.timeline,\n    score,\n    category: allowed.includes(category) ? category : 'COLD',\n    bant: q.bant || {},\n    reasoning: q.reasoning || '',\n    recommended_action: q.recommended_action || '',\n    red_flags: Array.isArray(q.red_flags) ? q.red_flags : [],\n    qualified_at: new Date().toISOString()\n  }\n}];"
      },
