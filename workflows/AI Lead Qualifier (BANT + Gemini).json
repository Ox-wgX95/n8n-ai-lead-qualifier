    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"score\", \"category\", \"bant\", \"reasoning\", \"recommended_action\", \"red_flags\"],\n  \"properties\": {\n    \"score\": { \"type\": \"number\", \"description\": \"Integer 1-10\" },\n    \"category\": { \"type\": \"string\", \"description\": \"HOT, WARM, COLD, or SPAM\" },\n    \"bant\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"budget\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"score\": { \"type\": \"number\" },\n            \"comment\": { \"type\": \"string\" }\n          }\n        },\n        \"authority\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"score\": { \"type\": \"number\" },\n            \"comment\": { \"type\": \"string\" }\n          }\n        },\n        \"need\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"score\": { \"type\": \"number\" },\n            \"comment\": { \"type\": \"string\" }\n          }\n        },\n        \"timeline\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"score\": { \"type\": \"number\" },\n            \"comment\": { \"type\": \"string\" }\n          }\n        }\n      }\n    },\n    \"reasoning\": { \"type\": \"string\" },\n    \"recommended_action\": { \"type\": \"string\" },\n    \"red_flags\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" }\n    }\n  }\n}"
      },
      "id": "3d4ddfe9-3db2-40c9-a78f-872b69481e6d",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        -864,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst lead = $('Prepare Lead Data').first().json;\n\nlet q = raw.output !== undefined ? raw.output : raw;\nif (q && typeof q === 'object' && q.output && typeof q.output === 'object' && q.score === undefined) {\n  q = q.output;\n}\nif (typeof q === 'string') {\n  try {\n    q = JSON.parse(q.replace(/```json\\s?/gi, '').replace(/```/g, '').trim());\n  } catch (error) {\n    q = {};\n  }\n}\n\nconst allowed = ['HOT', 'WARM', 'COLD', 'SPAM'];\nconst category = String(q.category || 'COLD').toUpperCase().trim();\nlet score = Number(q.score);\nif (!Number.isFinite(score)) score = 1;\nscore = Math.min(10, Math.max(1, Math.round(score)));\n\nreturn [{\n  json: {\n    name: lead.name,\n    email: lead.email,\n    company: lead.company,\n    budget: lead.budget,\n    project_description: lead.project_description,\n    timeline: lead.timeline,\n    score,\n    category: allowed.includes(category) ? category : 'COLD',\n    bant: q.bant || {},\n    reasoning: q.reasoning || '',\n    recommended_action: q.recommended_action || '',\n    red_flags: Array.isArray(q.red_flags) ? q.red_flags : [],\n    qualified_at: new Date().toISOString()\n  }\n}];"
      },
